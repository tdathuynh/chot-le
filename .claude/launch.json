{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "cwd": "app",
      "port": 8081
    },
    {
      "name": "web-demo",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set EXPO_NO_DOTENV=1&& npx expo start --web --port 8090"
      ],
      "cwd": "app",
      "port": 8090
    }
  ]
}